---
import Button from "@components/ui/Button.astro";
import type { HeroContent } from "@i18n/types";
import { Icon } from "astro-icon/components";

interface Props {
  content: HeroContent;
}

const { content } = Astro.props;
---

<section aria-labelledby="hero-title" class="w-full px-5 pt-6 text-center sm:px-8">
  <div class="mx-auto flex max-w-3xl flex-col items-center gap-6">
    <h1 id="hero-title" class="landing-enter landing-enter-title m-0 text-[clamp(3.25rem,15vw,4rem)] leading-[0.98] font-normal tracking-tighter sm:text-[clamp(3.25rem,8vw,7rem)]">
      <span class="block">{content.title}</span>
      <span class="block font-serif text-[min(1.1em,16vw)] leading-[0.95] tracking-tight italic sm:text-[min(1.1em,14vw)]">{content.titleSecondLine}</span>
    </h1>
    <div class="landing-enter landing-enter-description flex max-w-108 flex-col items-center">
      <p class="text-[clamp(1rem,1.35vw,1.25rem)] leading-tight text-pretty text-white/80">{content.description}</p>
    </div>
  </div>
  <Button href={content.cta.href} aria-label={content.cta.label} iconOnly class="landing-enter landing-enter-action fixed inset-x-0 bottom-6 z-10 mx-auto max-sm:size-11 sm:bottom-10">
    <Icon name="ui/arrow-right" aria-hidden="true" class="size-5 rotate-90 text-subtitle" />
  </Button>
</section>
