---
import logoLight from "@assets/images/brand/logo-light.avif?url";
import logoDark from "@assets/images/brand/logo-dark.avif?url";

interface Props {
  homeHref: string;
  label: string;
  onImage?: boolean;
}

const { homeHref, label, onImage = false } = Astro.props;
---

<a href={homeHref} aria-label={label} class:list={["inline-flex items-center gap-1.5 whitespace-nowrap text-sm font-medium tracking-[-0.7px] focus-visible:outline-2 focus-visible:outline-offset-4 min-[381px]:text-base md:gap-2.5 md:text-[17px] lg:text-xl", !onImage && "text-title focus-visible:outline-accent"]}>
  <img src={logoLight} alt="" width="32" height="32" class="block size-6.5 shrink-0 object-contain lg:size-7.5 dark:hidden" />
  <img src={logoDark} alt="" width="32" height="32" class="hidden size-6.5 shrink-0 object-contain lg:size-7.5 dark:block" />
  <span>davidelamarca</span>
</a>
