---
import type { NavigationLink } from "@i18n/types";
import { Icon } from "astro-icon/components";

interface Props {
  links: ReadonlyArray<NavigationLink>;
  homeHref: string;
}

const { links, homeHref } = Astro.props;
---

<ol>
  {links.map(({ label, href }, index) => (
    <li class="border-b border-outline">
      <a href={href} aria-current={href === homeHref ? "page" : undefined} class="group/link flex min-w-0 items-center gap-5 py-5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:gap-7 lg:py-6">
        <span class:list={["min-w-0 flex-1 text-[clamp(3.25rem,12vw,4.5rem)] leading-none tracking-[-0.065em] transition-[color,translate] duration-300 group-hover/link:translate-x-1 group-hover/link:text-accent lg:text-[clamp(4.5rem,8vw,8rem)] motion-reduce:transition-none", href === homeHref ? "text-accent" : "text-title"]}>{label}</span>
        <Icon name="ui/arrow-right" class="size-6 shrink-0 -rotate-45 text-subtitle transition-[rotate,color] duration-300 group-hover/link:rotate-0 group-hover/link:text-accent sm:size-8 motion-reduce:transition-none" />
      </a>
    </li>
  ))}
</ol>
