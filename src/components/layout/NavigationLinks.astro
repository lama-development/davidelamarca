---
import type { NavigationLink } from "@i18n/types";
import { Icon } from "astro-icon/components";

interface Props {
  links: ReadonlyArray<NavigationLink>;
  homeHref: string;
}

const { links, homeHref } = Astro.props;
---

<ol class="t-stagger">
  {links.map(({ label, href }, index) => (
    <li class="t-stagger-line" style={`--stagger-index: ${index}`}>
      <a href={href} aria-current={href === homeHref ? "page" : undefined} class="t-navigation-link flex min-w-0 items-center gap-4 py-6 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:gap-6 sm:py-7">
        <span class:list={["t-navigation-label min-w-0 flex-1 text-[clamp(3rem,8vw,8rem)] leading-[1.04] tracking-tighter", href === homeHref ? "font-serif text-title" : "text-subtitle"]}>{label}</span>
        <Icon name="ui/arrow-right" class="t-navigation-icon size-7 shrink-0 text-subtitle sm:size-10" />
      </a>
    </li>
  ))}
</ol>
