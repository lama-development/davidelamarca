---
import Brand from "@components/layout/Brand.astro";
import SiteMenu from "@components/layout/SiteMenu.astro";
import type { NavigationContent, PreferencesContent } from "@i18n/types";
import { Icon } from "astro-icon/components";

interface Props {
  navbar: NavigationContent;
  lang: string;
  preferences: PreferencesContent;
}

const { navbar, lang, preferences } = Astro.props;
---

<header class="absolute inset-x-0 top-0 z-2 flex items-center justify-between gap-4 p-5 md:p-6 lg:px-12 lg:py-7 min-[1800px]:px-[4vw]">
  <Brand navbar={navbar} onImage />
  <button type="button" data-menu-trigger aria-controls="site-menu" aria-expanded="false" aria-haspopup="dialog" aria-label={navbar.aria.navigation} title={navbar.aria.navigation} class="group grid size-11 cursor-pointer place-items-center focus-visible:outline-2 focus-visible:outline-offset-2">
    <Icon name="ui/menu" class="size-6 transition-transform duration-200 group-hover:-translate-x-0.5 motion-reduce:transition-none" />
  </button>
</header>

<SiteMenu navbar={navbar} lang={lang} preferences={preferences} />
