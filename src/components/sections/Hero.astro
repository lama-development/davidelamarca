---
import type { HeroContent } from "@i18n/types";
import Button from "@components/ui/Button.astro";

interface Props {
  content: HeroContent;
  ctaHref: string;
}

const { content, ctaHref } = Astro.props;
---

<section aria-labelledby="hero-title" class="w-full px-5 py-[clamp(20px,3.5svh,32px)] text-left sm:px-6 sm:py-[clamp(24px,5svh,72px)] lg:px-12">
  <div class="grid grid-cols-1 items-start gap-[clamp(16px,3svh,28px)] sm:grid-cols-[minmax(0,1.65fr)_minmax(0,1fr)] sm:gap-[clamp(32px,5vw,96px)]">
    <h1 id="hero-title" class="m-0 text-[clamp(48px,10vw,64px)] leading-[1.03] font-normal tracking-[-0.065em] sm:text-[clamp(48px,min(5vw,9svh),96px)]">
      {content.title}
      <br />
      <span>{content.titleSecondLine}</span>
    </h1>
    <div class="max-w-140 sm:pt-1">
      <p class="mb-6 text-[clamp(17px,1.35vw,25px)] leading-[1.4] tracking-[-0.035em] text-subtitle">
        {content.description} {content.descriptionSecondLine}
      </p>
      <Button href={ctaHref} variant="primary" class="text-base font-normal">
        {content.cta}
      </Button>
    </div>
  </div>
</section>
