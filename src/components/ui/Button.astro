---
import type { HTMLAttributes } from "astro/types";

type Props = {
  variant?: "translucent" | "primary" | "secondary" | "destructive";
  iconOnly?: boolean;
} & ((HTMLAttributes<"button"> & { href?: never }) | (Omit<HTMLAttributes<"a">, "type"> & { href: string; type?: never }));

const { variant = "translucent", iconOnly = false, class: className, href, type, ...attributes } = Astro.props;
const Element = href === undefined ? "button" : "a";

const variants = {
  translucent: "bg-card/80 text-title",
  primary: "bg-accent text-label",
  secondary: "border border-outline bg-card text-title",
  destructive: "bg-destructive text-white"
};
---

<Element href={href} type={Element === "button" ? (type ?? "button") : type} data-variant={variant} class:list={["t-button inline-flex shrink-0 items-center justify-center rounded-full text-sm", iconOnly ? "size-12" : "min-h-12 gap-3 px-5", variants[variant], className]} {...attributes}>
  <slot />
</Element>
